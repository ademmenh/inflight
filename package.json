{
    "name": "@inflightjs/inflight",
    "version": "0.0.0",
    "description": "Deduplicate concurrent requests by queryKey",
    "repository": {
        "type": "git",
        "url": "https://github.com/ademmenh/inflight"
    },
    "main": "dist/inflight.js",
    "module": "dist/inflight.js",
    "types": "dist/inflight.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "lint": "eslint src/",
        "lint:fix": "eslint --fix src/",
        "test": "bun test src/tests/",
        "bench": "bun run benchmarks/bench.ts",
        "bench:docker": "docker compose -f benchmarks/docker-compose.yml up --build",
        "semantic-release": "semantic-release"
    },
    "keywords": [
        "dedup",
        "inflight",
        "concurrent",
        "request",
        "query"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "GPL-3.0-only",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/bun": "latest",
        "drizzle-orm": "^0.45.2",
        "eslint": "^10.9.1",
        "iovalkey": "^0.4.0",
        "postgres": "^3.4.9",
        "semantic-release": "^25.0.9",
        "typescript": "^5",
        "typescript-eslint": "^8.68.0"
    }
}
